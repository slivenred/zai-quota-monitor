{
  "name": "zai-quota-monitor",
  "displayName": "Z.ai Quota Monitor",
  "description": "Monitor Z.ai GLM Coding Plan quota with a refined status bar overview and reset countdown",
  "version": "1.0.1",
  "publisher": "slivenred",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/slivenred/zai-quota-monitor"
  },
  "bugs": {
    "url": "https://github.com/slivenred/zai-quota-monitor/issues"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "zai",
    "z.ai",
    "glm",
    "quota",
    "usage",
    "monitor",
    "countdown"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zaiQuota.refresh",
        "title": "%zaiQuota.command.refresh%",
        "category": "%zaiQuota.category%"
      },
      {
        "command": "zaiQuota.configure",
        "title": "%zaiQuota.command.configure%",
        "category": "%zaiQuota.category%"
      },
      {
        "command": "zaiQuota.showDetail",
        "title": "%zaiQuota.command.showDetail%",
        "category": "%zaiQuota.category%"
      },
      {
        "command": "zaiQuota.debugRaw",
        "title": "%zaiQuota.command.debugRaw%",
        "category": "%zaiQuota.category%"
      }
    ],
    "configuration": {
      "title": "%zaiQuota.config.title%",
      "properties": {
        "zaiQuota.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "%zaiQuota.config.refreshInterval%",
          "order": 1
        },
        "zaiQuota.warnThreshold": {
          "type": "number",
          "default": 85,
          "minimum": 50,
          "maximum": 100,
          "description": "%zaiQuota.config.warnThreshold%",
          "order": 2
        },
        "zaiQuota.showCountdown": {
          "type": "boolean",
          "default": true,
          "description": "%zaiQuota.config.showCountdown%",
          "order": 3
        },
        "zaiQuota.language": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "zh-CN",
            "zh-TW"
          ],
          "enumDescriptions": [
            "%zaiQuota.language.en%",
            "%zaiQuota.language.zhCN%",
            "%zaiQuota.language.zhTW%"
          ],
          "description": "%zaiQuota.config.language%",
          "order": 4
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.1.0"
  }
}
